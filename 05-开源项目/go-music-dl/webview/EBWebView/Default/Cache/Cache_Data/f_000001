<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="referrer" content="no-referrer">
    <title>music-dl - 聚合搜索与解析</title>
    <link rel="icon" href="/music/icon.png" type="image/png">
    
    <link rel="stylesheet" href="/music/style.css">
    <link rel="stylesheet" href="/music/videogen.css">
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aplayer/dist/APlayer.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sakana-widget@2.7.1/lib/sakana.min.css"/>
</head>
<body>


<div id="download-panel" class="download-panel" style="display:none;">
    <div class="download-panel-header">
        <span><i class="fa-solid fa-download"></i> 下载中</span>
        <span class="download-panel-close" onclick="closeDownloadPanel()">&times;</span>
    </div>
    <div class="download-panel-body" id="download-panel-body"></div>
    <div class="download-panel-footer" id="download-panel-footer"></div>
</div>


<div class="right-toolbar">
    
    <div class="rt-btn" onclick="openSystemConfig()" title="系统配置"><i class="fa-solid fa-gear"></i></div>
    <form id="auth-float-form" class="rt-form" action="/music/logout" method="post" title="登录">
        <button id="auth-float-button" type="submit"><i id="auth-float-icon" class="fa-solid fa-right-to-bracket"></i></button>
    </form>
    <div class="rt-btn" onclick="openLocalMusicPage()" title="本地音乐"><i class="fa-solid fa-folder-plus"></i></div>
    <div class="rt-btn" onclick="openDownloadRecordsModal()" title="下载记录"><i class="fa-solid fa-clock-rotate-left"></i></div>
    <div class="rt-btn" onclick="openPlaybackHistoryModal()" title="播放历史"><i class="fa-solid fa-clock"></i></div>

    

    <div class="rt-separator"></div>

    
    <div class="rt-btn" onclick="scrollToTop()" title="回到顶部"><i class="fa-solid fa-arrow-up"></i></div>
    <div class="rt-btn" onclick="scrollToBottom()" title="回到底部"><i class="fa-solid fa-arrow-down"></i></div>
</div>

<div class="container">
    
<div class="search-box">
    <h1>🎵 <a href="https://github.com/guohuiyuan/go-music-dl" target="_blank" style="color: inherit; text-decoration: none;">music-dl</a></h1>
    <form action="/music/search" method="get" id="search-form">
        <input type="hidden" name="page" value="1">
        <input type="hidden" name="page_size" id="page-size-hidden" value="200">
        <div class="search-type-switch">
            <label class="type-option">
                <input type="radio" name="type" value="song"
                    checked
                    onchange="toggleSearchType(this.value)">
                <span>单曲搜索</span>
            </label>
            <label class="type-option">
                <input type="radio" name="type" value="playlist"
                    
                    onchange="toggleSearchType(this.value)">
                <span>歌单搜索</span>
            </label>
            <label class="type-option">
                <input type="radio" name="type" value="album"
                    
                    onchange="toggleSearchType(this.value)">
                <span>专辑搜索</span>
            </label>
        </div>

        <div class="input-group">
            <input type="text" id="search-keyword" name="q" value="" placeholder="搜索歌曲、歌手，或直接粘贴分享链接" required autocomplete="off">
            <button type="submit" class="search-btn"><i class="fa-solid fa-magnifying-glass"></i></button>
        </div>

        <div style="display: flex; gap: 15px; justify-content: center; margin-bottom: 20px; flex-wrap: wrap;">
            <button type="button" class="btn-pill btn-pill-primary" onclick="goToRecommend()"
                style="background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%); border: none; box-shadow: 0 4px 15px rgba(255, 154, 158, 0.4); justify-content:center;">
                <i class="fa-solid fa-fire"></i> 每日推荐歌单
            </button>
            <button type="button" class="btn-pill btn-pill-fav" onclick="openCollectionManager()">
                <i class="fa-solid fa-folder-open"></i> 本地歌单
            </button>
            <button type="button" class="btn-pill btn-pill-fav" onclick="openLocalMusicPage()">
                <i class="fa-solid fa-music"></i> 本地音乐
            </button>
            <button type="button" class="btn-pill btn-pill-category" onclick="goToPlaylistCategories()">
                <i class="fa-solid fa-table-cells-large"></i> 歌单分类
            </button>
            <button type="button" class="btn-pill btn-pill-mine" onclick="goToUserPlaylists()">
                <i class="fa-solid fa-heart"></i> 我的歌单
            </button>
        </div>

        

        <div class="source-selector" id="source-selector">
            <div class="source-header">
                <button type="button" class="source-collapse-btn" onclick="toggleSourceSelector()" aria-expanded="true" aria-controls="source-grid">
                    <span class="source-title">搜索源设置</span>
                    <i class="fa-solid fa-chevron-up source-collapse-icon" aria-hidden="true"></i>
                </button>
                <div class="source-actions">
                    <button type="button" class="ctrl-btn" id="btn-all">全选</button>
                    <button type="button" class="ctrl-btn" id="btn-none">清空</button>
                </div>
            </div>

            <div class="source-grid" id="source-grid">
                
                <label>
                    <input type="checkbox" name="sources" value="netease" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="true"
                        data-category-supported="true"
                        data-user-playlist-supported="true"
                        
                            checked
                        >
                    <div class="source-card">
                        <div class="source-name">netease</div>
                        <div class="source-desc">网易云音乐</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="qq" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="true"
                        data-category-supported="true"
                        data-user-playlist-supported="true"
                        
                            checked
                        >
                    <div class="source-card">
                        <div class="source-name">qq</div>
                        <div class="source-desc">QQ音乐</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="kugou" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="true"
                        data-category-supported="true"
                        data-user-playlist-supported="true"
                        
                            checked
                        >
                    <div class="source-card">
                        <div class="source-name">kugou</div>
                        <div class="source-desc">酷狗音乐</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="kuwo" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="true"
                        data-category-supported="true"
                        data-user-playlist-supported="false"
                        
                            checked
                        >
                    <div class="source-card">
                        <div class="source-name">kuwo</div>
                        <div class="source-desc">酷我音乐</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="migu" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="true"
                        data-category-supported="true"
                        data-user-playlist-supported="false"
                        
                            checked
                        >
                    <div class="source-card">
                        <div class="source-name">migu</div>
                        <div class="source-desc">咪咕音乐</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="fivesing" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="false"
                        data-category-supported="false"
                        data-user-playlist-supported="false"
                        
                            
                        >
                    <div class="source-card">
                        <div class="source-name">fivesing</div>
                        <div class="source-desc">5sing</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="jamendo" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="true"
                        data-category-supported="false"
                        data-user-playlist-supported="false"
                        
                            
                        >
                    <div class="source-card">
                        <div class="source-name">jamendo</div>
                        <div class="source-desc">Jamendo (CC)</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="joox" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="true"
                        data-category-supported="true"
                        data-user-playlist-supported="false"
                        
                            
                        >
                    <div class="source-card">
                        <div class="source-name">joox</div>
                        <div class="source-desc">JOOX</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="qianqian" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="true"
                        data-category-supported="true"
                        data-user-playlist-supported="false"
                        
                            checked
                        >
                    <div class="source-card">
                        <div class="source-name">qianqian</div>
                        <div class="source-desc">千千音乐</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="soda" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="true"
                        data-category-supported="false"
                        data-user-playlist-supported="true"
                        
                            checked
                        >
                    <div class="source-card">
                        <div class="source-name">soda</div>
                        <div class="source-desc">汽水音乐</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="bilibili" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="false"
                        data-category-supported="false"
                        data-user-playlist-supported="false"
                        
                            
                        >
                    <div class="source-card">
                        <div class="source-name">bilibili</div>
                        <div class="source-desc">Bilibili</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="apple" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="true"
                        data-category-supported="true"
                        data-user-playlist-supported="false"
                        
                            checked
                        >
                    <div class="source-card">
                        <div class="source-name">apple</div>
                        <div class="source-desc">Apple Music</div>
                    </div>
                </label>
                
                <label>
                    <input type="checkbox" name="sources" value="local" class="source-checkbox"
                        data-playlist-supported="true"
                        data-album-supported="false"
                        data-category-supported="false"
                        data-user-playlist-supported="false"
                        
                            
                        >
                    <div class="source-card">
                        <div class="source-name">local</div>
                        <div class="source-desc">本地音乐</div>
                    </div>
                </label>
                
            </div>
        </div>
    </form>
</div>


    





    




    





    


</div>


