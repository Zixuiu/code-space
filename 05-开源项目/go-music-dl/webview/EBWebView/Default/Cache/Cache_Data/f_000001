            <div class="modal-close" onclick="document.getElementById('cookieModal').style.display='none'"><i class="fa-solid fa-xmark"></i></div>
        </div>
        <div class="modal-body">
            <div class="cookie-list">
                
                <div class="cookie-item">
                    <label>netease</label>
                    <div class="cookie-input-row">
                        <input type="text" id="cookie-netease" placeholder="在此粘贴 Cookie...">
                        
                        
                        <button type="button" class="cookie-qr-btn" onclick="startQRLogin('netease')"><i class="fa-solid fa-qrcode"></i> 扫码</button>
                        
                        
                    </div>
                </div>
                
                <div class="cookie-item">
                    <label>qq</label>
                    <div class="cookie-input-row">
